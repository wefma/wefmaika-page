---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getHome, withBase } from "../lib/content";
import { getPosts } from "../lib/posts";

const page = getHome();
const posts = (await getPosts()).slice(0, 3);
---
<BaseLayout title={page.seo?.title || page.title} description={page.seo?.description || page.description}>
  <section class="hero center fade-in">
    <img class="avatar" src={withBase("/global/ayame.webp")} alt="My profile picture" width="144" height="144" />
    <h1>{page.title}</h1>
    <p>{page.description}</p>
    <div class="hero-social">
      <a href="https://x.com/iyuzzuko" target="_blank" rel="noopener noreferrer" aria-label="Twitter" title="Twitter"><Icon name="x" /></a>
      <a href="https://www.youtube.com/@%E3%82%91%E3%81%B5%E3%81%BE%E3%81%84%E3%81%8B" target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube"><Icon name="youtube" /></a>
      <a href="https://github.com/wefma" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
    </div>
  </section>
  <section class="section">
    <h2>{page.about.title}</h2>
    <p class="description">{page.about.description}</p>
  </section>
  <section class="section">
    <h2>{page.blog.title}</h2>
    <p class="description">{page.blog.description}</p>
    <div class="card-list">
      {posts.map((post) => <article class="card-copy"><h3><a href={withBase(`/blog/${post.slug}`)}>{post.title}</a></h3><p>{post.description}</p><a class="link-primary" href={withBase(`/blog/${post.slug}`)}>Read Article</a></article>)}
    </div>
  </section>
</BaseLayout>
