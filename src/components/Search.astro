---
import Icon from "./Icon.astro";
type SearchPost = { slug: string; title: string; description: string };
const { posts } = Astro.props as { posts: SearchPost[] };
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<button class="icon-button" id="search-open" aria-label="Search posts" title="Search (⌘K)"><Icon name="search" /></button>
<dialog class="search-dialog" id="search-dialog" aria-label="Search posts" data-base={base}>
  <input class="search-input" id="search-input" type="search" placeholder="Search posts..." autocomplete="off" />
  <div class="search-results" id="search-results"></div>
</dialog>
<script id="search-data" type="application/json" set:html={JSON.stringify(posts)}></script>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#search-dialog")!;
  const base = dialog.dataset.base || "/";
  const input = document.querySelector<HTMLInputElement>("#search-input")!;
  const results = document.querySelector<HTMLDivElement>("#search-results")!;
  const posts = JSON.parse(document.querySelector("#search-data")?.textContent || "[]");
  const render = (query = "") => {
    const term = query.trim().toLocaleLowerCase();
    const matches = posts.filter((post: { title: string; description: string }) => !term || `${post.title} ${post.description}`.toLocaleLowerCase().includes(term));
    results.replaceChildren(...matches.slice(0, 20).map((post: { slug: string; title: string; description: string }) => {
      const link = document.createElement("a");
      link.className = "search-result";
      link.href = `${base}blog/${post.slug}`;
      const title = document.createElement("strong"); title.textContent = post.title;
      const description = document.createElement("span"); description.textContent = post.description;
      link.append(title, description);
      return link;
    }));
  };
  const open = () => { render(); dialog.showModal(); input.focus(); };
  document.querySelector("#search-open")?.addEventListener("click", open);
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") { event.preventDefault(); open(); }
    if (event.key === "Escape" && dialog.open) dialog.close();
  });
  input.addEventListener("input", () => render(input.value));
  dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
</script>
